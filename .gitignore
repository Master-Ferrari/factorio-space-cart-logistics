# ── Автосейвы и бэкапы 3D-софта ───────────────────────────
# Cinema 4D пишет сюда копию каждые несколько минут — 154 МБ
# почти одинаковых файлов. В репозитории им делать нечего.
3d/backup/

# Substance Painter: ~173 МБ на каждый автосейв
*_autosave_*.spp
*.spp.autosave

# Blender: .blend1/.blend2 — автоматические предыдущие версии
*.blend[0-9]

# ── Мусор ОС ──────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store

# ── 3D: промежуточные рендеры и кэш Python ───────────────
# Пересобираются make.py ассета; в репозитории — скрипты, .blend и листы.
3d/**/out/render/
3d/cart/blocking/render/
3d/cart/blocking/r*/render/
__pycache__/

# Фильм: выход сборки (img/ собирается из film/data и папок вариантов)
3d/cart/film/img/
3d/cart/film/index_*.html

# Хайполи для запекания в Painter (пересобирается make.py --from export)
3d/**/out/bake/
*.painter_lock
