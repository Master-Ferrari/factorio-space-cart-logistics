# ── Автосейвы и бэкапы 3D-софта ───────────────────────────
# Cinema 4D пишет сюда копию каждые несколько минут — 154 МБ
# почти одинаковых файлов. В репозитории им делать нечего.
3d/backup/

# Substance Painter: ~173 МБ на каждый автосейв
*_autosave_*.spp
*.spp.autosave

# Blender: .blend1/.blend2 — автоматические предыдущие версии
*.blend[0-9]

# ── Мусор ОС ──────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
